{
  "name": "etheria-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot Discord de l'univers Etheria",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx src/database/check.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:status": "tsx src/database/migrate.ts --status",
    "db:migrate:plan": "tsx src/database/migrate.ts --dry-run",
    "db:migrate:baseline": "tsx src/database/migrate.ts --baseline 0001_initial_core.sql"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "@types/pg": "^8.11.11"
  }
}
