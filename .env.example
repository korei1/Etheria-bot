# Variables locales du bot Etheria.
# Ne publiez jamais les vraies valeurs dans GitHub.
DISCORD_TOKEN=replace_with_your_bot_token

# URL PostgreSQL fournie par le tableau de bord Supabase.
# Gardez ce secret dans les variables d'environnement de l'hébergeur.
# Choisissez une URL avec SSL (sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
